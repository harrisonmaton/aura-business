{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "outDir": "dist-test",
    "rootDir": "src"
  },
  "include": [
    "src/core/**/*.ts",
    "src/verticals/**/*.ts",
    "src/billing/**/*.ts",
    "src/data/depot.ts"
  ]
}
